{
  "manifest_version": 3,
  "name": "TableAutoFill - IP Portal Autofiller",
  "version": "1.0.0",
  "description": "Smartly autofill inputs in webpage tables by matching records from uploaded Excel, CSV files or image files.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:5173/students*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "TableAutoFill - Excel & CSV Autofiller",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:5173/students*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
